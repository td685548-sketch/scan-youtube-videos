# YouTube Data API v3 key (https://console.cloud.google.com/apis/library/youtube.googleapis.com)
YOUTUBE_API_KEY=
# Optional: override the channel handle (default below)
YOUTUBE_CHANNEL_HANDLE=@Professor-Glitch-automation
# Optional: classify topics with Gemini (free key from https://aistudio.google.com). Falls back to keyword rules if unset.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# Optional: how "Animation" is described to Gemini when running `npm run scan -- --style`
# STYLE_ANIMATION_DESCRIPTION=
# STYLE_PAUSE_MS=6000

# Optional: several Gemini keys, comma-separated, rotated when one hits its rate limit.
# Quota is per Google Cloud project, so each key must belong to a different project to help.
# GEMINI_API_KEYS=key1,key2
# Optional text-only fallbacks for topic classification (tried in this order after Gemini).
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Daily publish (npm run publish): upload the Excel reports to OneDrive and notify a Teams channel.
# Azure app registration with *application* permission Microsoft Graph > Files.ReadWrite.All (admin consent).
# MS_TENANT_ID=
# MS_CLIENT_ID=
# MS_CLIENT_SECRET=
# Owner of the OneDrive (e-mail/UPN), or use ONEDRIVE_DRIVE_ID for a SharePoint document library.
# ONEDRIVE_USER=someone@yourcompany.com
# ONEDRIVE_DRIVE_ID=
# ONEDRIVE_FOLDER=YouTube AI Scan
# Teams: channel > Workflows > "Post to a channel when a webhook request is received" > copy the URL.
# TEAMS_WEBHOOK_URL=
